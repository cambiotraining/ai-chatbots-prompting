{
  "name": "prompting-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A life-sciences prompting workshop with blind comparisons and budgeted OpenAI access.",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/prepare-markdown.mjs",
    "predev": "npm run build",
    "dev": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "budget": "node scripts/budget.mjs",
    "pilot": "node scripts/pilot.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": { "markdown-it": "15.0.3" },
  "devDependencies": { "wrangler": "^4.0.0" }
}
